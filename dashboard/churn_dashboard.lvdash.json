{
  "datasets": [
    {
      "name": "ds_bands",
      "displayName": "Risk bands",
      "queryLines": [
        "SELECT risk_band, count(*) AS customers,\n",
        "       round(sum(monthly_bill_eur)*12,0) AS annual_revenue_eur\n",
        "FROM plenitude_febar.gold.churn_scores\n",
        "GROUP BY risk_band"
      ]
    },
    {
      "name": "ds_region",
      "displayName": "Churn by region",
      "queryLines": [
        "SELECT region, count(*) AS customers,\n",
        "       round(avg(churn_probability),3) AS avg_churn_prob,\n",
        "       sum(CASE WHEN risk_band IN ('High','Critical') THEN 1 ELSE 0 END) AS at_risk\n",
        "FROM plenitude_febar.gold.churn_scores\n",
        "GROUP BY region ORDER BY avg_churn_prob DESC"
      ]
    },
    {
      "name": "ds_var",
      "displayName": "Value at risk",
      "queryLines": [
        "SELECT round(sum(monthly_bill_eur)*12,0) AS annual_revenue_at_risk,\n",
        "       round(sum(monthly_bill_eur)*12*0.22,0) AS margin_at_risk\n",
        "FROM plenitude_febar.gold.churn_scores\n",
        "WHERE risk_band IN ('High','Critical')"
      ]
    },
    {
      "name": "ds_drivers",
      "displayName": "Top-list",
      "queryLines": [
        "SELECT customer_id, region, product, risk_band,\n",
        "       round(churn_probability*100,1) AS churn_pct, top_reasons\n",
        "FROM plenitude_febar.gold.churn_scores\n",
        "ORDER BY churn_probability DESC LIMIT 100"
      ]
    }
  ],
  "pages": [
    {
      "name": "overview",
      "displayName": "Voice-to-Retention",
      "layout": [
        {
          "widget": {
            "name": "w_var",
            "queries": [{"name": "main", "query": {"datasetName": "ds_var", "fields": [
              {"name": "annual_revenue_at_risk", "expression": "`annual_revenue_at_risk`"}], "disaggregated": false}}],
            "spec": {"version": 2, "widgetType": "counter",
              "encodings": {"value": {"fieldName": "annual_revenue_at_risk", "displayName": "Annual revenue at risk (€)"}}}
          },
          "position": {"x": 0, "y": 0, "width": 2, "height": 3}
        },
        {
          "widget": {
            "name": "w_var_margin",
            "queries": [{"name": "main", "query": {"datasetName": "ds_var", "fields": [
              {"name": "margin_at_risk", "expression": "`margin_at_risk`"}], "disaggregated": false}}],
            "spec": {"version": 2, "widgetType": "counter",
              "encodings": {"value": {"fieldName": "margin_at_risk", "displayName": "Margin at risk (€)"}}}
          },
          "position": {"x": 2, "y": 0, "width": 2, "height": 3}
        },
        {
          "widget": {
            "name": "w_bands",
            "queries": [{"name": "main", "query": {"datasetName": "ds_bands", "fields": [
              {"name": "risk_band", "expression": "`risk_band`"},
              {"name": "customers", "expression": "`customers`"}], "disaggregated": false}}],
            "spec": {"version": 3, "widgetType": "pie",
              "encodings": {"angle": {"fieldName": "customers", "displayName": "customers"},
                            "color": {"fieldName": "risk_band", "displayName": "risk_band"}}}
          },
          "position": {"x": 4, "y": 0, "width": 2, "height": 6}
        },
        {
          "widget": {
            "name": "w_region",
            "queries": [{"name": "main", "query": {"datasetName": "ds_region", "fields": [
              {"name": "region", "expression": "`region`"},
              {"name": "avg_churn_prob", "expression": "`avg_churn_prob`"}], "disaggregated": false}}],
            "spec": {"version": 3, "widgetType": "bar",
              "encodings": {"x": {"fieldName": "region", "scale": {"type": "categorical"}, "displayName": "region"},
                            "y": {"fieldName": "avg_churn_prob", "scale": {"type": "quantitative"}, "displayName": "avg churn prob"}}}
          },
          "position": {"x": 0, "y": 3, "width": 4, "height": 4}
        },
        {
          "widget": {
            "name": "w_list",
            "queries": [{"name": "main", "query": {"datasetName": "ds_drivers", "fields": [
              {"name": "customer_id", "expression": "`customer_id`"},
              {"name": "region", "expression": "`region`"},
              {"name": "risk_band", "expression": "`risk_band`"},
              {"name": "churn_pct", "expression": "`churn_pct`"},
              {"name": "top_reasons", "expression": "`top_reasons`"}], "disaggregated": true}}],
            "spec": {"version": 1, "widgetType": "table",
              "encodings": {"columns": [
                {"fieldName": "customer_id", "displayName": "Customer"},
                {"fieldName": "region", "displayName": "Region"},
                {"fieldName": "risk_band", "displayName": "Band"},
                {"fieldName": "churn_pct", "displayName": "Churn %"},
                {"fieldName": "top_reasons", "displayName": "Top reasons"}]}}
          },
          "position": {"x": 0, "y": 7, "width": 6, "height": 6}
        }
      ]
    }
  ]
}
